# --- CONFIGURAÇÕES GERAIS ---
set $mod Mod4
font pango:monospace, sans-serif 10

input * {
    xkb_layout br
}

# --- EFEITOS VISUAIS (SWAYFX) ---
corner_radius 20
shadows enable
shadow_blur_radius 20

blur enable
blur_xray enable
blur_passes 3
blur_radius 8

# Aparência das Janelas
default_border pixel 2
gaps inner 10
gaps outer 10

# Regras de Janelas (Opacidade Thunar 50%)
for_window [app_id="nemo"] opacity 0.5

# --- AUTOSTART ---
exec --no-startup-id nm-applet
exec  swww-daemon &
exec_always lxqt-policykit-agent &

# --- VOLUME ---
bindsym XF86AudioRaiseVolume exec pactl set-sink-volume @DEFAULT_SINK@ +5%
bindsym XF86AudioLowerVolume exec pactl set-sink-volume @DEFAULT_SINK@ -5%
bindsym XF86AudioMute exec pactl set-sink-mute @DEFAULT_SINK@ toggle

# Atalhos extras de volume
bindsym $mod+equal exec pactl set-sink-volume @DEFAULT_SINK@ +5%
bindsym $mod+minus exec pactl set-sink-volume @DEFAULT_SINK@ -5%

# --- TERMINAL / LAUNCHER ---
bindsym $mod+Return exec kitty
bindsym $mod+q kill
bindsym $mod+d exec rofi -show drun
bindsym $mod+b exec ~/.config/hypr/scripts/wallpaper_random.sh
bindsym $mod+p exec python3 ~/.config/waypaper/mini_swww_selector.py

# --- NAVEGAÇÃO ---
bindsym $mod+j focus left
bindsym $mod+k focus down
bindsym $mod+l focus up
bindsym $mod+ccedilla focus right

# --- WORKSPACES ---
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

bindsym $mod+1 workspace $ws1
bindsym $mod+2 workspace $ws2
bindsym $mod+3 workspace $ws3
bindsym $mod+4 workspace $ws4
bindsym $mod+5 workspace $ws5
bindsym $mod+6 workspace $ws6
bindsym $mod+7 workspace $ws7
bindsym $mod+8 workspace $ws8
bindsym $mod+9 workspace $ws9
bindsym $mod+0 workspace $ws10

# --- MOVER JANELA PARA WORKSPACE ---
bindsym $mod+Shift+1 move container to workspace $ws1
bindsym $mod+Shift+2 move container to workspace $ws2
bindsym $mod+Shift+3 move container to workspace $ws3
bindsym $mod+Shift+4 move container to workspace $ws4
bindsym $mod+Shift+5 move container to workspace $ws5
bindsym $mod+Shift+6 move container to workspace $ws6
bindsym $mod+Shift+7 move container to workspace $ws7
bindsym $mod+Shift+8 move container to workspace $ws8
bindsym $mod+Shift+9 move container to workspace $ws9
bindsym $mod+Shift+0 move container to workspace $ws10

# --- SISTEMA ---
bindsym $mod+Shift+c reload
bindsym $mod+Shift+e exec "swaymsg exit"

# --- BARRA ---
bar {
    position top
    status_command sh $HOME/.config/sway/status.sh

    colors {
        background #1e1e2e
        statusline #cdd6f4
        separator  #6c7086

        focused_workspace  #89b4fa #89b4fa #1e1e2e
        active_workspace   #313244 #313244 #cdd6f4
        inactive_workspace #1e1e2e #1e1e2e #6c7086
        urgent_workspace   #f38ba8 #f38ba8 #1e1e2e
    }
}